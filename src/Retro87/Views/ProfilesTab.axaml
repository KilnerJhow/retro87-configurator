<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Retro87.ViewModels"
             xmlns:loc="using:Retro87.Localization"
             xmlns:m="using:Retro87.Models"
             xmlns:svc="using:Retro87.Services"
             xmlns:views="using:Retro87.Views"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="Retro87.Views.ProfilesTab"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <StackPanel Margin="8,12" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="{loc:T tab_profiles}" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{loc:T profiles_hint}" />
            </StackPanel>

            <!-- on the keyboard now -->
            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="{loc:T on_keyboard_now}" Margin="0" />
                        <StackPanel IsVisible="{Binding HasDeviceProfile}" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="h1" Text="{Binding CurrentProfileName}" Margin="0"
                                           VerticalAlignment="Center" />
                                <Border BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                        Background="{StaticResource AccentSoft}" CornerRadius="10"
                                        Padding="8,1" IsVisible="{Binding CurrentDiffers}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{loc:T differs_from_saved_tip}">
                                    <TextBlock FontSize="11" Foreground="{StaticResource Accent}"
                                               Text="{loc:T differs_from_saved}" />
                                </Border>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="10" Padding="8,1"
                                        IsVisible="{Binding CurrentHasNoCopy}"
                                        VerticalAlignment="Center">
                                    <TextBlock Classes="muted" FontSize="11" Text="{loc:T no_local_copy}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding CurrentProfileSummary}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding HasNoDeviceProfile}" Spacing="4">
                            <TextBlock Classes="h1" Text="{loc:T no_profile}" Margin="0" Foreground="{StaticResource FgMuted}" />
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="{loc:T no_profile_hint}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding HasDeviceProfile}">
                        <Button Content="{loc:T edit}" Command="{Binding EditCurrentProfileCommand}"
                                ToolTip.Tip="{loc:T edit_tip}" />
                        <Button Content="{loc:T save_copy}" Command="{Binding SaveCurrentCopyCommand}"
                                ToolTip.Tip="{loc:T save_copy_tip}" />
                        <Button Classes="icon" AutomationProperties.Name="{loc:T more_keyboard_profile}">
                            <Path Classes="iconGlyph"
                                  Data="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{loc:T rename}" Command="{Binding RenameCurrentProfileCommand}" />
                                    <MenuItem Header="{loc:T clear_keyboard}" Command="{Binding ClearKeyboardCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- saved -->
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Classes="section" Text="{loc:T saved_here_header}" Margin="0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="muted" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{Binding SavedProfilesCount}" />
                    <Button Grid.Column="3" Content="{loc:T new_profile}" Command="{Binding NewProfileCommand}" />
                </Grid>

                <Border Classes="note" IsVisible="{Binding IsProfileListEmpty}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,10">
                        <TextBlock Classes="dim" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Text="{loc:T no_saved_profiles}" />
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="460"
                                   Text="{loc:T no_saved_profiles_hint}" />
                        <Button Classes="primary" Content="{loc:T save_current_profile}" HorizontalAlignment="Center"
                                Command="{Binding SaveCurrentCopyCommand}"
                                IsVisible="{Binding HasDeviceProfile}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="0" IsVisible="{Binding !IsProfileListEmpty}">
                    <ItemsControl ItemsSource="{Binding SavedProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavedProfileItem">
                                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1"
                                        Padding="14,12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                        CornerRadius="10" Padding="8,0"
                                                        IsVisible="{Binding SameNameOnKeyboard}">
                                                    <TextBlock Classes="muted" FontSize="11" Text="{loc:T same_name_as_keyboard}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="muted" FontSize="12">
                                                <Run Text="{Binding Info}" /><Run Text="{loc:T saved_sep}" /><Run Text="{Binding SavedText}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Classes="primary" Content="{loc:T activate}"
                                                    Command="{Binding ActivateCommand}"
                                                    ToolTip.Tip="{loc:T activate_tip}" />
                                            <Button Classes="icon" AutomationProperties.Name="{loc:T more_profile}">
                                                <Path Classes="iconGlyph"
                                                      Data="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuItem Header="{loc:T rename}"
                                                                  Command="{Binding RenameCommand}" />
                                                        <MenuItem Header="{loc:T copy}"
                                                                  Command="{Binding CopyCommand}" />
                                                        <MenuItem Header="{loc:T show_folder}"
                                                                  Command="{Binding ShowFolderCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:T delete_item}"
                                                                  Command="{Binding DeleteCommand}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Classes="muted key" FontSize="11" Text="{Binding ProfilesDirectory}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
