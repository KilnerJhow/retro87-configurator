<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hardware-free self-test, bench probes and the simulated devices. Not shipped with the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Retro87.Bench</AssemblyName>
    <RootNamespace>Retro87</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Retro87/Retro87.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Retro87.Tests" />
  </ItemGroup>
</Project>
