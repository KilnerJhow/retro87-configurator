<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Retro87.ViewModels"
             xmlns:loc="using:Retro87.Localization"
             xmlns:m="using:Retro87.Models"
             xmlns:svc="using:Retro87.Services"
             xmlns:views="using:Retro87.Views"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="Retro87.Views.NameDialog"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="#CC0F1219" IsVisible="{Binding IsNameDialogOpen}">
        <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="10" Padding="20"
                AutomationProperties.Name="{Binding NameDialogTitle}">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="{Binding NameDialogTitle}" TextWrapping="Wrap" />
                <StackPanel Spacing="6" IsVisible="{Binding NameDialogHasInput}">
                    <TextBlock Classes="section" Text="{loc:T name_header}" Margin="0" />
                    <TextBox Text="{Binding NameDialogInput}" MaxLength="{Binding ProfileNameMaxLength}"
                             PlaceholderText="{loc:T name_hint}" AutomationProperties.Name="{loc:T profile_name}" />
                    <TextBlock Foreground="{StaticResource Danger}" FontSize="12" Text="{Binding NameDialogError}"
                               IsVisible="{Binding NameDialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding NameDialogShowSource}">
                    <RadioButton GroupName="origem" IsChecked="{Binding NewFromKeyboard}"
                                 Content="{loc:T start_from_keyboard}" />
                    <RadioButton GroupName="origem" IsChecked="{Binding NewFromBlank}"
                                 Content="{loc:T start_blank}" />
                </StackPanel>
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding NameDialogText}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="{loc:T cancel}" Command="{Binding CancelNameDialogCommand}" IsCancel="True" />
                    <Button Classes="primary" Content="{Binding NameDialogConfirm}"
                            Command="{Binding ConfirmNameDialogCommand}" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
