<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Retro87.ViewModels"
        xmlns:loc="using:Retro87.Localization"
        xmlns:m="using:Retro87.Models"
        xmlns:svc="using:Retro87.Services"
        xmlns:views="using:Retro87.Views"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        x:Class="Retro87.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:T window_title}"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        MinWidth="880" MinHeight="600">
    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshDevicesCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ReadConfigCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding OpenSaveDialogCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelSaveDialogCommand}" />
        <KeyBinding Gesture="Alt+D1" Command="{Binding GoToTabCommand}" CommandParameter="0" />
        <KeyBinding Gesture="Alt+D2" Command="{Binding GoToTabCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Alt+D3" Command="{Binding GoToTabCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Alt+D4" Command="{Binding GoToTabCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Alt+D5" Command="{Binding GoToTabCommand}" CommandParameter="4" />
    </Window.KeyBindings>
    <Grid>
    <DockPanel LastChildFill="True" IsEnabled="{Binding !IsAnyDialogOpen}">

        <!-- ============================================================ header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,26,0">
                    <TextBlock Classes="title" Text="Retro 87" />
                    <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Left" TextAlignment="Left"
                               Text="{loc:T app_subtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsConnected}">
                    <TextBlock Classes="warn" IsVisible="{Binding IsReadOnlySession}" VerticalAlignment="Center"
                               Text="{loc:T read_only}" Margin="0,0,6,0" />
                    <TextBlock Classes="muted" Text="{Binding ChangesSummary}" VerticalAlignment="Center"
                               IsVisible="{Binding CanSave}" Margin="0,0,2,0" />
                    <Button Classes="primary" Content="{loc:T save}" Command="{Binding OpenSaveDialogCommand}"
                            IsVisible="{Binding CanSave}"
                            AutomationProperties.AcceleratorKey="Ctrl+S"
                            ToolTip.Tip="{loc:T save_tip}" />
                    <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="4,0" />
                    <TextBlock Text="{Binding SelectedDevice.DisplayName}" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                IsVisible="{Binding HasBattery}"
                                AutomationProperties.Name="{Binding BatteryAccessibleName}">
                        <Grid Width="31" Height="16" VerticalAlignment="Center">
                            <Border Width="29" Height="16" HorizontalAlignment="Left" CornerRadius="3"
                                    BorderThickness="1.5" BorderBrush="{StaticResource FgDim}" Padding="1.5">
                                <Border Width="{Binding BatteryFillWidth}" HorizontalAlignment="Left"
                                        CornerRadius="1" Background="{Binding BatteryBrush}" />
                            </Border>
                            <Border Width="2.5" Height="6" HorizontalAlignment="Right" CornerRadius="0,1,1,0"
                                    Background="{StaticResource FgDim}" />
                        </Grid>
                        <TextBlock Text="{Binding BatteryText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Classes="ghost" Command="{Binding ReadConfigCommand}"
                            IsEnabled="{Binding CanUseDevice}" Padding="8"
                            AutomationProperties.Name="{loc:T reread}"
                            AutomationProperties.AcceleratorKey="Ctrl+L"
                            ToolTip.Tip="{loc:T reread_tip}">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource FgDim}"
                              Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                    </Button>
                    <Button Classes="ghost" Content="{loc:T switch_keyboard}"
                            Command="{Binding DisconnectDeviceCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="{loc:T switch_keyboard_tip}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                    <ComboBox Width="124" HorizontalAlignment="Right"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}"
                              AutomationProperties.Name="{loc:T language}"
                              ToolTip.Tip="{loc:T language}" />
                    <TextBlock Classes="warn" FontSize="11" HorizontalAlignment="Right"
                               Text="{Binding LanguageNotice}"
                               IsVisible="{Binding LanguageNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,9">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="Auto,*">
                    <Grid Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top"
                          Margin="0,4,9,0">
                        <Arc Classes="spinner" IsVisible="{Binding IsBusy}" Width="10" Height="10"
                             StartAngle="0" SweepAngle="270" StrokeThickness="1.6"
                             Stroke="{StaticResource Accent}" StrokeLineCap="Round"
                             AutomationProperties.Name="{loc:T busy}" />
                        <Grid IsVisible="{Binding !IsBusy}">
                        <Path Classes="statusMark" Fill="{Binding StatusGlyphBrush}"
                              IsVisible="{Binding StatusIsInfo}"
                              Data="M5 1a4 4 0 1 0 0 8 4 4 0 0 0 0-8z" />
                        <Path Classes="statusMark" Fill="{Binding StatusGlyphBrush}"
                              IsVisible="{Binding StatusIsSuccess}"
                              Data="M3.9 8.3 1.2 5.6l1.4-1.4 1.3 1.3L7.4 2l1.4 1.4z" />
                        <Path Classes="statusMark" Fill="{Binding StatusGlyphBrush}"
                              IsVisible="{Binding StatusIsWarning}"
                              Data="M4.15 1h1.7l-.25 5h-1.2zM5 7.1a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1z" />
                        <Path Classes="statusMark" Fill="{Binding StatusGlyphBrush}"
                              IsVisible="{Binding StatusIsError}"
                              Data="M2.1 1 5 3.9 7.9 1 9 2.1 6.1 5 9 7.9 7.9 9 5 6.1 2.1 9 1 7.9 3.9 5 1 2.1z" />
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{Binding StatusTextBrush}" />
                </Grid>
                <TextBlock Text="{Binding UpdateMessage}" Foreground="{Binding UpdateBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding UpdateMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <!-- ============================================================ abas -->
        <Grid>
        <!-- ============================================================ keyboard list -->
        <Grid ColumnDefinitions="340,*" IsVisible="{Binding !IsConnected}">
            <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,18">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,10">
                        <TextBlock Classes="section" Text="{loc:T keyboards_header}" VerticalAlignment="Center" Margin="0" />
                        <Button Grid.Column="1" Classes="ghost" Content="{loc:T refresh}"
                                Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding !IsBusy}"
                                AutomationProperties.AcceleratorKey="F5"
                                ToolTip.Tip="{loc:T refresh_tip}" />
                    </Grid>
                    <Border Classes="note" DockPanel.Dock="Top" IsVisible="{Binding !Devices.Count}">
                        <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                                   Text="{loc:T no_keyboard_found}" />
                    </Border>
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="{loc:T keyboards_found}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:DeviceInfo">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="2,4">
                                    <Ellipse Grid.Row="0" Width="8" Height="8" Fill="{StaticResource Ok}"
                                             VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontSize="12"
                                               Text="{Binding Summary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="22" Margin="40,0">
                <svg:Svg Path="/Brand/keyboard-list.svg" Width="560" Stretch="Uniform"
                         IsHitTestVisible="False" />
                <StackPanel Spacing="22" HorizontalAlignment="Center"
                            IsVisible="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="28" RowSpacing="6" HorizontalAlignment="Center">
                        <TextBlock Grid.Row="0" Classes="muted" Text="{loc:T connection}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="dim" Text="{Binding SelectedDevice.ConnectionKind}" />
                        <TextBlock Grid.Row="1" Classes="muted" Text="{loc:T serial}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="dim" Text="{Binding SelectedDevice.SerialText}"
                                   FontFamily="Consolas,DejaVu Sans Mono,Menlo,monospace" />
                        <TextBlock Grid.Row="2" Classes="muted" Text="{loc:T family}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="dim" Text="{Binding SelectedDevice.FamilyName}" />
                    </Grid>
                    <Button Classes="primary" Content="{loc:T connect}" Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Center" Padding="28,11" FontSize="14" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TabControl Margin="10,0,10,10" SelectedIndex="{Binding SelectedTabIndex}" IsVisible="{Binding IsConnected}">

            <!-- ================================================== mapping -->
            <TabItem Header="{loc:T tab_mapping}" ToolTip.Tip="Alt+1" AutomationProperties.AcceleratorKey="Alt+1">
                <!-- Row 0 is star: without it the ScrollViewer takes the height of its content, overflows the
                     window and no scrolling is left (the outer Grid does not scroll). -->
                <Grid Margin="8,12" RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8" Margin="0,0,18,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Classes="h1" Text="{loc:T keys}" />
                            <TextBlock Grid.Column="1" Classes="muted" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Text="{Binding MappingSummary}" IsVisible="{Binding HasMappings}" />
                            <Button Grid.Column="2" Classes="ghost" Content="{loc:T restore_all}"
                                    IsVisible="{Binding HasMappings}"
                                    Command="{Binding RestoreAllMappingsCommand}"
                                    ToolTip.Tip="{loc:T restore_all_tip}" />
                        </Grid>

                        <Border Classes="note" IsVisible="{Binding IsMappingEmpty}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="dim" FontWeight="SemiBold" FontSize="12"
                                           Text="{loc:T nothing_read}" />
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="{loc:T mapping_empty_hint}" />
                            </StackPanel>
                        </Border>

                        <!-- the drawn keyboard: each key is a button positioned by the board geometry.
                             The original artwork sits in a strip above, without covering the keycaps. -->
                        <Border x:Name="BoardCard" Classes="card" Padding="8" IsVisible="{Binding !IsMappingEmpty}">
                            <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Center">
                                <svg:Svg Path="/Brand/skin-keyboard-header.svg" Height="54"
                                         Stretch="Fill" IsHitTestVisible="False" />
                                <ItemsControl x:Name="KeysItems" ItemsSource="{Binding Keys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <views:KeyboardPanel Unit="46" Gap="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MappingRowViewModel">
                                            <Button Classes="keycap"
                                                    Background="{Binding KeyBackground}"
                                                    BorderBrush="{Binding KeyBorder}"
                                                    Command="{Binding SelectCommand}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    ToolTip.Tip="{Binding MappingTooltip}">
                                                <TextBlock Text="{Binding KeyCapLabel}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- The ten Super Buttons behind the connections: step 1 picks the connection, step 2
                             picks the button of the pair. The dashed frame is the callout (see DESIGN.md). -->
                        <Border Classes="card" Padding="10" IsVisible="{Binding !IsMappingEmpty}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section" Text="{loc:T super_buttons_header}" Margin="0"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="ghost"
                                            Content="{Binding PortStyleLabel}"
                                            Command="{Binding TogglePortStyleCommand}"
                                            ToolTip.Tip="{loc:T port_style_tip}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- the four ports, round as in the official app: they light up when the button is pressed -->
                                    <Border Grid.Column="0" Classes="note" Padding="14,10">
                                        <ItemsControl ItemsSource="{Binding SuperPorts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="14" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SuperConnectionViewModel">
                                                    <Button Classes="disc"
                                                            Command="{Binding SelectCommand}"
                                                            AutomationProperties.Name="{Binding AutomationName}"
                                                            ToolTip.Tip="{Binding Tooltip}">
                                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                            <Panel Height="18" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding ChipNameBrush}"
                                                                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}" />
                                                                <Viewbox Width="16" Height="16"
                                                                         IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                    <Panel Width="16" Height="16">
                                                                        <Path Data="{Binding IconFill}"
                                                                              Fill="{Binding ChipNameBrush}" />
                                                                        <Path Data="{Binding IconLines}"
                                                                              Stroke="{Binding ChipNameBrush}"
                                                                              StrokeThickness="1.5"
                                                                              StrokeJoin="Miter" />
                                                                    </Panel>
                                                                </Viewbox>
                                                            </Panel>
                                                            <Grid Width="56" Height="56">
                                                                <Ellipse Fill="{Binding JackFill}"
                                                                         Stroke="{Binding JackRing}"
                                                                         StrokeThickness="{Binding JackRingWidth}"
                                                                         Margin="2" />
                                                                <Ellipse Width="22" Height="22"
                                                                         Fill="{StaticResource Bg}"
                                                                         Stroke="{Binding JackRing}"
                                                                         StrokeThickness="1" />
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                                        HorizontalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding FirstDot}" />
                                                                <Ellipse Width="7" Height="7" Fill="{Binding SecondDot}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0" Spacing="8">
                                <!-- step 1: the connection -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsConnectionStepVisible}">
                                        <Line StartPoint="0,0" EndPoint="26,0" Width="26" Height="1"
                                              Stroke="{StaticResource FgMuted}" StrokeThickness="1"
                                              StrokeDashArray="3,3" VerticalAlignment="Center" />
                                        <TextBlock Classes="muted" FontSize="11"
                                                   Text="{loc:T super_step1}" />
                                    </StackPanel>
                                </Grid>

                                <!-- step 2: the pair of the chosen connection, cut out. The cut-out only exists
                                     after the choice; the frame withdraws once the button is chosen. -->
                                <Grid ColumnDefinitions="Auto,*"
                                      IsVisible="{Binding IsPairVisible}">
                                    <Grid Grid.Column="0">
                                        <ItemsControl x:Name="PairItems" ItemsSource="{Binding SuperPair}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MappingRowViewModel">
                                                    <Button Classes="disc"
                                                            Width="120"
                                                            Command="{Binding SelectCommand}"
                                                            AutomationProperties.Name="{Binding AutomationName}"
                                                            ToolTip.Tip="{Binding MappingTooltip}">
                                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                                                <Ellipse Fill="{Binding DiscFill}"
                                                                         Stroke="{Binding DiscRing}"
                                                                         StrokeThickness="3" Margin="2" />
                                                                <TextBlock Text="+" FontSize="30"
                                                                           Foreground="{StaticResource Fg}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding HasNoTarget}" />
                                                                <Ellipse Width="7" Height="7"
                                                                         Fill="{StaticResource Accent}"
                                                                         HorizontalAlignment="Right"
                                                                         VerticalAlignment="Top"
                                                                         IsVisible="{Binding IsModified}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding KeyName}" FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock FontSize="10" HorizontalAlignment="Center"
                                                                       Foreground="{Binding MappingBrush}"
                                                                       Text="{Binding MappingName}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Rectangle IsHitTestVisible="False"
                                                   IsVisible="{Binding IsPairStepVisible}"
                                                   Stroke="{StaticResource FgMuted}" StrokeThickness="1"
                                                   StrokeDashArray="3,3" RadiusX="9" RadiusY="9"
                                                   Margin="-6" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center" Margin="12,0,0,0"
                                                IsVisible="{Binding IsPairStepVisible}">
                                        <Line StartPoint="0,0" EndPoint="26,0" Width="26" Height="1"
                                              Stroke="{StaticResource FgMuted}" StrokeThickness="1"
                                              StrokeDashArray="3,3" VerticalAlignment="Center" />
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding PairStepText}" />
                                    </StackPanel>
                                </Grid>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Classes="warn" FontSize="11" TextWrapping="Wrap"
                                           IsVisible="{Binding IsListeningForSuperButton}"
                                           Text="{loc:T super_listening}" />

                                <!-- last identified button: the port shows with the Mecha Break symbol -->
                                <Border Classes="note" IsVisible="{Binding HasSuperButtonPress}"
                                        Margin="0,2,0,0" Padding="10,7">
                                    <TextBlock FontSize="11" TextWrapping="Wrap"
                                               Text="{Binding LastSuperButtonText}" />
                                </Border>

                                <!-- identification question: covers the case of two buttons with the same
                                     target (two ports on Play/Pause) or a key that could not be read -->
                                <Border Classes="note" IsVisible="{Binding IsAskingSuperButton}"
                                        Margin="0,4,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="warn" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Text="{Binding SuperButtonQuestion}" />
                                        <TextBlock Classes="hint" FontSize="11" TextWrapping="Wrap"
                                                   Text="{loc:T super_pick}" />
                                        <ItemsControl ItemsSource="{Binding SuperButtonChoices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MappingRowViewModel">
                                                    <Button Classes="chip" Margin="0,0,6,6"
                                                            Command="{Binding SelectCommand}"
                                                            ToolTip.Tip="{Binding Detail}">
                                                        <StackPanel Spacing="0">
                                                            <TextBlock Text="{Binding KeyName}"
                                                                       FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Classes="key" FontSize="10"
                                                                       Foreground="{StaticResource FgMuted}"
                                                                       Text="{Binding MappingName}" />
                                                            <TextBlock Classes="muted" FontSize="9"
                                                                       Text="{Binding Detail}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Classes="ghost" Content="{loc:T cancel}"
                                                HorizontalAlignment="Left"
                                                Command="{Binding CancelSuperButtonQuestionCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Key editor: a popover next to the clicked key, as in the official app. The
                         MainWindow.axaml.cs points the PlacementTarget at the selected key. -->
                    <Popup x:Name="KeyPopup" Placement="Bottom"
                           IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True"
                           Closed="OnKeyPopupClosed">
                        <views:SelectedKeyPanel />
                    </Popup>

                </Grid>
            </TabItem>

            <!-- ================================================== macros -->
            <TabItem Header="{loc:T tab_macros}" ToolTip.Tip="Alt+2" AutomationProperties.AcceleratorKey="Alt+2">
                <ScrollViewer>
                    <StackPanel Margin="8,12" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h1" Text="{loc:T tab_macros}" />
                            <TextBlock Classes="hint" FontSize="12"
                                       Text="{loc:T macros_hint}" />
                        </StackPanel>

                        <Border Classes="note" IsVisible="{Binding IsMacrosEmpty}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="dim" FontWeight="SemiBold" FontSize="12"
                                           Text="{loc:T nothing_read}" />
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="{loc:T macros_empty_hint}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Macros}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MacroSlotViewModel">
                                    <Border Classes="card" Margin="0,0,0,10">
                                        <StackPanel Spacing="10">
                                            <!-- Empty slot: a single row instead of a whole form. -->
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  IsVisible="{Binding IsCollapsed}">
                                                <TextBlock Grid.Column="0" Classes="key" FontWeight="SemiBold"
                                                           Text="{Binding SlotLabel}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="muted" FontSize="12"
                                                           Margin="12,0" VerticalAlignment="Center"
                                                           Text="{loc:T empty}" />
                                                <Button Grid.Column="2" Classes="tiny" Content="{loc:T create_macro}"
                                                        Command="{Binding EditCommand}"
                                                        AutomationProperties.Name="{Binding CreateName}" />
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                                  IsVisible="{Binding IsEditing}">
                                                <TextBlock Grid.Column="0" Classes="key" FontWeight="SemiBold"
                                                           Text="{Binding SlotLabel}"
                                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                                <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="{loc:T macro_name_hint}"
                                                         MaxWidth="260" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="2" Classes="muted" Text="{loc:T cycles}"
                                                           VerticalAlignment="Center" Margin="16,0,8,0" />
                                                <NumericUpDown Grid.Column="3" Value="{Binding Cycles}" Minimum="0"
                                                               Maximum="255" FormatString="0" Width="118"
                                                               ToolTip.Tip="{loc:T cycles_tip}" />
                                                <TextBlock Grid.Column="4" Classes="muted" Text="{loc:T interval_ms}"
                                                           VerticalAlignment="Center" Margin="16,0,8,0" />
                                                <NumericUpDown Grid.Column="5" Value="{Binding IntervalMs}" Minimum="0"
                                                               Maximum="65535" FormatString="0" Width="132"
                                                               ToolTip.Tip="{loc:T interval_tip}" />
                                                <Button Grid.Column="6" Classes="ghost" Content="{loc:T collapse}"
                                                        Command="{Binding CollapseCommand}"
                                                        IsVisible="{Binding CanCollapse}"
                                                        AutomationProperties.Name="{Binding CollapseName}"
                                                        ToolTip.Tip="{loc:T collapse_tip}" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        IsVisible="{Binding IsEditing}">
                                                <Button Classes="tiny" Content="{loc:T add_press}"
                                                        Command="{Binding AddKeyDownCommand}" />
                                                <Button Classes="tiny" Content="{loc:T add_release}"
                                                        Command="{Binding AddKeyUpCommand}" />
                                                <Button Classes="tiny" Content="{loc:T add_wait}"
                                                        Command="{Binding AddDelayCommand}" />
                                                <TextBlock Classes="muted" VerticalAlignment="Center"
                                                           Text="{Binding StepsText}" />
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Steps}"
                                                          IsVisible="{Binding IsEditing}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MacroStepViewModel">
                                                        <Grid ColumnDefinitions="150,*,Auto,Auto,Auto" Margin="0,2">
                                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                                      ItemsSource="{Binding KindOptions}"
                                                                      SelectedItem="{Binding SelectedKind}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:MacroKindOption">
                                                                        <TextBlock Text="{Binding Label}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <ComboBox Grid.Column="1" Margin="8,0"
                                                                      HorizontalAlignment="Stretch"
                                                                      IsVisible="{Binding IsKeyStep}"
                                                                      ItemsSource="{Binding Targets}"
                                                                      SelectedItem="{Binding SelectedTarget}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="m:MappingTarget">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding KindLabel}"
                                                                                       Classes="muted" FontSize="11"
                                                                                       Margin="14,0,0,0" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <NumericUpDown Grid.Column="1" Margin="8,0" Width="150"
                                                                           HorizontalAlignment="Left"
                                                                           IsVisible="{Binding IsDelayStep}"
                                                                           Value="{Binding DelayMs}" Minimum="0"
                                                                           Maximum="65535" FormatString="0" />
                                                            <Button Grid.Column="2" Classes="icon"
                                                                    Command="{Binding MoveUpCommand}"
                                                                    AutomationProperties.Name="{loc:T move_step_up}"
                                                                    ToolTip.Tip="{loc:T move_up}">
                                                                <Path Classes="iconGlyph"
                                                                      Data="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" />
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="icon"
                                                                    Command="{Binding MoveDownCommand}"
                                                                    AutomationProperties.Name="{loc:T move_step_down}"
                                                                    ToolTip.Tip="{loc:T move_down}">
                                                                <Path Classes="iconGlyph"
                                                                      Data="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" />
                                                            </Button>
                                                            <Button Grid.Column="4" Classes="icon"
                                                                    Command="{Binding RemoveCommand}"
                                                                    AutomationProperties.Name="{loc:T remove_the_step}"
                                                                    ToolTip.Tip="{loc:T remove_step}">
                                                                <Path Classes="iconGlyph"
                                                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== settings -->
            <TabItem Header="{loc:T tab_config}" ToolTip.Tip="Alt+3" AutomationProperties.AcceleratorKey="Alt+3">
                <ScrollViewer>
                    <StackPanel Margin="8,12" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h1" Text="{loc:T config_title}" />
                            <TextBlock Classes="muted" FontSize="12"
                                       Text="{loc:T config_hint}" />
                        </StackPanel>

                        <Border Classes="note" IsVisible="{Binding IsFamilyUnknown}">
                            <TextBlock Classes="hint" FontSize="12"
                                       Text="{loc:T config_empty_hint}" />
                        </Border>

                        <!-- JP family -->
                        <Border Classes="card" IsVisible="{Binding IsJpFamily}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section" Text="{loc:T special_feature_header}" Margin="0" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <NumericUpDown Value="{Binding SpecialFeature}" Minimum="0" Maximum="255"
                                                       FormatString="0" Width="130" />
                                        <TextBlock Classes="hint" VerticalAlignment="Center" FontSize="12"
                                                   Text="{loc:T byte_hint}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Xbox family (Retro 87 X) -->
                        <Border Classes="card" IsVisible="{Binding IsXboxFamily}">
                            <StackPanel Spacing="14">

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:T volume}" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <NumericUpDown Value="{Binding XboxVolumeLevel}" Minimum="0" Maximum="5"
                                                       FormatString="0" Width="130" />
                                        <TextBlock Classes="hint" VerticalAlignment="Center" FontSize="12"
                                                   Text="{loc:T volume_hint}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Classes="sep" />

                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:T quick_setup}" FontWeight="SemiBold" />
                                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                                               Text="{loc:T quick_setup_hint}" />
                                    <CheckBox Content="{loc:T disable_win}"
                                              IsChecked="{Binding XboxDisableWindowsKey}" />
                                    <CheckBox Content="{loc:T disable_alt_tab}"
                                              IsChecked="{Binding XboxDisableAltTab}" />
                                    <CheckBox Content="{loc:T disable_alt_f4}"
                                              IsChecked="{Binding XboxDisableAltF4}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== perfis -->
            <TabItem Header="{loc:T tab_profiles}" ToolTip.Tip="Alt+4" AutomationProperties.AcceleratorKey="Alt+4">
                <ScrollViewer>
                    <StackPanel Margin="8,12" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h1" Text="{loc:T tab_profiles}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{loc:T profiles_hint}" />
                        </StackPanel>

                        <!-- on the keyboard now -->
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section" Text="{loc:T on_keyboard_now}" Margin="0" />
                                    <StackPanel IsVisible="{Binding HasDeviceProfile}" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Classes="h1" Text="{Binding CurrentProfileName}" Margin="0"
                                                       VerticalAlignment="Center" />
                                            <Border BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                                    Background="{StaticResource AccentSoft}" CornerRadius="10"
                                                    Padding="8,1" IsVisible="{Binding CurrentDiffers}"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{loc:T differs_from_saved_tip}">
                                                <TextBlock FontSize="11" Foreground="{StaticResource Accent}"
                                                           Text="{loc:T differs_from_saved}" />
                                            </Border>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="10" Padding="8,1"
                                                    IsVisible="{Binding CurrentHasNoCopy}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="muted" FontSize="11" Text="{loc:T no_local_copy}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding CurrentProfileSummary}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding HasNoDeviceProfile}" Spacing="4">
                                        <TextBlock Classes="h1" Text="{loc:T no_profile}" Margin="0" Foreground="{StaticResource FgMuted}" />
                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                                   Text="{loc:T no_profile_hint}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            IsVisible="{Binding HasDeviceProfile}">
                                    <Button Content="{loc:T edit}" Command="{Binding EditCurrentProfileCommand}"
                                            ToolTip.Tip="{loc:T edit_tip}" />
                                    <Button Content="{loc:T save_copy}" Command="{Binding SaveCurrentCopyCommand}"
                                            ToolTip.Tip="{loc:T save_copy_tip}" />
                                    <Button Classes="icon" AutomationProperties.Name="{loc:T more_keyboard_profile}">
                                        <Path Classes="iconGlyph"
                                              Data="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="{loc:T rename}" Command="{Binding RenameCurrentProfileCommand}" />
                                                <MenuItem Header="{loc:T clear_keyboard}" Command="{Binding ClearKeyboardCommand}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- saved -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Classes="section" Text="{loc:T saved_here_header}" Margin="0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="muted" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding SavedProfilesCount}" />
                                <Button Grid.Column="3" Content="{loc:T new_profile}" Command="{Binding NewProfileCommand}" />
                            </Grid>

                            <Border Classes="note" IsVisible="{Binding IsProfileListEmpty}">
                                <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,10">
                                    <TextBlock Classes="dim" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Text="{loc:T no_saved_profiles}" />
                                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               MaxWidth="460"
                                               Text="{loc:T no_saved_profiles_hint}" />
                                    <Button Classes="primary" Content="{loc:T save_current_profile}" HorizontalAlignment="Center"
                                            Command="{Binding SaveCurrentCopyCommand}"
                                            IsVisible="{Binding HasDeviceProfile}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="0" IsVisible="{Binding !IsProfileListEmpty}">
                                <ItemsControl ItemsSource="{Binding SavedProfiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SavedProfileItem">
                                            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1"
                                                    Padding="14,12">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                                    CornerRadius="10" Padding="8,0"
                                                                    IsVisible="{Binding SameNameOnKeyboard}">
                                                                <TextBlock Classes="muted" FontSize="11" Text="{loc:T same_name_as_keyboard}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Classes="muted" FontSize="12">
                                                            <Run Text="{Binding Info}" /><Run Text="{loc:T saved_sep}" /><Run Text="{Binding SavedText}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <Button Classes="primary" Content="{loc:T activate}"
                                                                Command="{Binding ActivateCommand}"
                                                                ToolTip.Tip="{loc:T activate_tip}" />
                                                        <Button Classes="icon" AutomationProperties.Name="{loc:T more_profile}">
                                                            <Path Classes="iconGlyph"
                                                                  Data="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
                                                            <Button.Flyout>
                                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                    <MenuItem Header="{loc:T rename}"
                                                                              Command="{Binding RenameCommand}" />
                                                                    <MenuItem Header="{loc:T copy}"
                                                                              Command="{Binding CopyCommand}" />
                                                                    <MenuItem Header="{loc:T show_folder}"
                                                                              Command="{Binding ShowFolderCommand}" />
                                                                    <Separator />
                                                                    <MenuItem Header="{loc:T delete_item}"
                                                                              Command="{Binding DeleteCommand}" />
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Classes="muted key" FontSize="11" Text="{Binding ProfilesDirectory}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== about the keyboard -->
            <TabItem Header="{loc:T tab_about}" ToolTip.Tip="Alt+5" AutomationProperties.AcceleratorKey="Alt+5">
                <ScrollViewer>
                    <StackPanel Margin="8,12" Spacing="12">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="{loc:T keyboard_header}" Margin="0" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="28" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Classes="muted" Text="{loc:T model}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.ProductName}" />
                                    <TextBlock Grid.Row="1" Classes="muted" Text="{loc:T connection}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.ConnectionKind}" />
                                    <TextBlock Grid.Row="2" Classes="muted" Text="{loc:T family}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.FamilyName}" />
                                    <TextBlock Grid.Row="3" Classes="muted" Text="{loc:T serial}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.SerialText}"
                                               FontFamily="Consolas,DejaVu Sans Mono,Menlo,monospace" />
                                    <TextBlock Grid.Row="4" Classes="muted" Text="{loc:T firmware}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FirmwareVersionText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="{loc:T firmware_header}" Margin="0" />
                                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                                           Text="{loc:T firmware_hint}" />
                                <Button Command="{Binding CheckUpdateCommand}"
                                        IsEnabled="{Binding CanUseDevice}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Arc Classes="spinner" IsVisible="{Binding IsBusy}" Width="12" Height="12"
                                             StartAngle="0" SweepAngle="270" StrokeThickness="2"
                                             Stroke="{StaticResource Accent}" StrokeLineCap="Round"
                                             VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:T check_updates}" IsVisible="{Binding !IsBusy}" />
                                        <TextBlock Text="{loc:T checking}" IsVisible="{Binding IsBusy}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Grid>
    </DockPanel>
    <!-- ================================================================ save to the keyboard -->
    <Border Background="#CC0F1219" IsVisible="{Binding IsSaveDialogOpen}">
        <Border Width="560" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="10" Padding="20"
                AutomationProperties.Name="{loc:T save_dialog_title}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,14">
                    <TextBlock Classes="title" Text="{loc:T save_dialog_title}" />
                    <TextBlock Classes="muted" Text="{Binding SaveDialogSummary}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SaveDialogNote}"
                               IsVisible="{Binding SaveDialogNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,16,0,0">
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:T save_dialog_hint}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="{loc:T cancel}" Command="{Binding CancelSaveDialogCommand}"
                                IsCancel="True" />
                        <Button Classes="primary" Content="{loc:T write_to_keyboard}" Command="{Binding ConfirmSaveCommand}"
                                IsDefault="True" />
                    </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*" Margin="12,8">
                            <TextBlock Classes="section" Text="{loc:T col_item}" Margin="0" />
                            <TextBlock Grid.Column="1" Classes="section" Text="{loc:T col_on_keyboard}" Margin="0" />
                            <TextBlock Grid.Column="2" Classes="section" Text="{loc:T col_after_save}" Margin="0" />
                        </Grid>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChangeItem">
                                        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0"
                                                Padding="12,8">
                                            <Grid ColumnDefinitions="*,*,*">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Classes="dim" Text="{Binding Before}"
                                                           TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding After}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
    </Border>
    <!-- ====== profile name: new, copy, rename, delete ====== -->
    <Border Background="#CC0F1219" IsVisible="{Binding IsNameDialogOpen}">
        <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="10" Padding="20"
                AutomationProperties.Name="{Binding NameDialogTitle}">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="{Binding NameDialogTitle}" TextWrapping="Wrap" />
                <StackPanel Spacing="6" IsVisible="{Binding NameDialogHasInput}">
                    <TextBlock Classes="section" Text="{loc:T name_header}" Margin="0" />
                    <TextBox Text="{Binding NameDialogInput}" MaxLength="{Binding ProfileNameMaxLength}"
                             Watermark="{loc:T name_hint}" AutomationProperties.Name="{loc:T profile_name}" />
                    <TextBlock Foreground="{StaticResource Danger}" FontSize="12" Text="{Binding NameDialogError}"
                               IsVisible="{Binding NameDialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding NameDialogShowSource}">
                    <RadioButton GroupName="origem" IsChecked="{Binding NewFromKeyboard}"
                                 Content="{loc:T start_from_keyboard}" />
                    <RadioButton GroupName="origem" IsChecked="{Binding NewFromBlank}"
                                 Content="{loc:T start_blank}" />
                </StackPanel>
                <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding NameDialogText}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="{loc:T cancel}" Command="{Binding CancelNameDialogCommand}" IsCancel="True" />
                    <Button Classes="primary" Content="{Binding NameDialogConfirm}"
                            Command="{Binding ConfirmNameDialogCommand}" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>

