<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Retro87.ViewModels"
             xmlns:loc="using:Retro87.Localization"
             xmlns:m="using:Retro87.Models"
             xmlns:svc="using:Retro87.Services"
             xmlns:views="using:Retro87.Views"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="Retro87.Views.SaveDialog"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="#CC0F1219" IsVisible="{Binding IsSaveDialogOpen}">
        <Border Width="560" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="10" Padding="20"
                AutomationProperties.Name="{loc:T save_dialog_title}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,14">
                    <TextBlock Classes="title" Text="{loc:T save_dialog_title}" />
                    <TextBlock Classes="muted" Text="{Binding SaveDialogSummary}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SaveDialogNote}"
                               IsVisible="{Binding SaveDialogNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,16,0,0">
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:T save_dialog_hint}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="{loc:T cancel}" Command="{Binding CancelSaveDialogCommand}"
                                IsCancel="True" />
                        <Button Classes="primary" Content="{loc:T write_to_keyboard}" Command="{Binding ConfirmSaveCommand}"
                                IsDefault="True" />
                    </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*" Margin="12,8">
                            <TextBlock Classes="section" Text="{loc:T col_item}" Margin="0" />
                            <TextBlock Grid.Column="1" Classes="section" Text="{loc:T col_on_keyboard}" Margin="0" />
                            <TextBlock Grid.Column="2" Classes="section" Text="{loc:T col_after_save}" Margin="0" />
                        </Grid>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChangeItem">
                                        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0"
                                                Padding="12,8">
                                            <Grid ColumnDefinitions="*,*,*">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Classes="dim" Text="{Binding Before}"
                                                           TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding After}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
