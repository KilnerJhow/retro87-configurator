<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Retro87.ViewModels"
        xmlns:loc="using:Retro87.Localization"
        xmlns:m="using:Retro87.Models"
        xmlns:svc="using:Retro87.Services"
        xmlns:views="using:Retro87.Views"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="Retro87.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:T window_title}"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        MinWidth="880" MinHeight="600">
    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshDevicesCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ReadConfigCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding OpenSaveDialogCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelSaveDialogCommand}" />
        <KeyBinding Gesture="Alt+D1" Command="{Binding GoToTabCommand}" CommandParameter="0" />
        <KeyBinding Gesture="Alt+D2" Command="{Binding GoToTabCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Alt+D3" Command="{Binding GoToTabCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Alt+D4" Command="{Binding GoToTabCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Alt+D5" Command="{Binding GoToTabCommand}" CommandParameter="4" />
    </Window.KeyBindings>
    <Grid>
    <DockPanel LastChildFill="True" IsEnabled="{Binding !IsAnyDialogOpen}">

        <!-- ============================================================ header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,26,0">
                    <TextBlock Classes="title" Text="Retro 87" />
                    <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Left" TextAlignment="Left"
                               Text="{loc:T app_subtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsConnected}">
                    <TextBlock Classes="warn" IsVisible="{Binding IsReadOnlySession}" VerticalAlignment="Center"
                               Text="{loc:T read_only}" Margin="0,0,6,0" />
                    <TextBlock Classes="muted" Text="{Binding ChangesSummary}" VerticalAlignment="Center"
                               IsVisible="{Binding CanSave}" Margin="0,0,2,0" />
                    <Button Classes="primary" Content="{loc:T save}" Command="{Binding OpenSaveDialogCommand}"
                            IsVisible="{Binding CanSave}"
                            AutomationProperties.AcceleratorKey="Ctrl+S"
                            ToolTip.Tip="{loc:T save_tip}" />
                    <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="4,0" />
                    <TextBlock Text="{Binding SelectedDevice.DisplayName}" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                IsVisible="{Binding HasBattery}"
                                AutomationProperties.Name="{Binding BatteryAccessibleName}">
                        <Grid Width="31" Height="16" VerticalAlignment="Center">
                            <Border Width="29" Height="16" HorizontalAlignment="Left" CornerRadius="3"
                                    BorderThickness="1.5" BorderBrush="{StaticResource FgDim}" Padding="1.5">
                                <Border Width="{Binding BatteryFillWidth}" HorizontalAlignment="Left"
                                        CornerRadius="1" Background="{Binding BatteryBrush}" />
                            </Border>
                            <Border Width="2.5" Height="6" HorizontalAlignment="Right" CornerRadius="0,1,1,0"
                                    Background="{StaticResource FgDim}" />
                        </Grid>
                        <TextBlock Text="{Binding BatteryText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Classes="ghost" Command="{Binding ReadConfigCommand}"
                            IsEnabled="{Binding CanUseDevice}" Padding="8"
                            AutomationProperties.Name="{loc:T reread}"
                            AutomationProperties.AcceleratorKey="Ctrl+L"
                            ToolTip.Tip="{loc:T reread_tip}">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource FgDim}"
                              Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                    </Button>
                    <Button Classes="ghost" Content="{loc:T switch_keyboard}"
                            Command="{Binding DisconnectDeviceCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="{loc:T switch_keyboard_tip}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                    <ComboBox Width="124" HorizontalAlignment="Right"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}"
                              AutomationProperties.Name="{loc:T language}"
                              ToolTip.Tip="{loc:T language}" />
                    <TextBlock Classes="warn" FontSize="11" HorizontalAlignment="Right"
                               Text="{Binding LanguageNotice}"
                               IsVisible="{Binding LanguageNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,9">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="Auto,*">
                    <Grid Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top"
                          Margin="0,4,9,0">
                        <Arc Classes="spinner" IsVisible="{Binding IsBusy}" Width="10" Height="10"
                             StartAngle="0" SweepAngle="270" StrokeThickness="1.6"
                             Stroke="{StaticResource Accent}" StrokeLineCap="Round"
                             AutomationProperties.Name="{loc:T busy}" />
                        <Grid IsVisible="{Binding !IsBusy}">
                        <Path Classes="statusMark" Fill="{Binding StatusGlyphBrush}"
                              IsVisible="{Binding StatusIsInfo}"
                              Data="M5 1a4 4 0 1 0 0 8 4 4 0 0 0 0-8z" />
                        <Path Classes="statusMark" Fill="{Binding StatusGlyphBrush}"
                              IsVisible="{Binding StatusIsSuccess}"
                              Data="M3.9 8.3 1.2 5.6l1.4-1.4 1.3 1.3L7.4 2l1.4 1.4z" />
                        <Path Classes="statusMark" Fill="{Binding StatusGlyphBrush}"
                              IsVisible="{Binding StatusIsWarning}"
                              Data="M4.15 1h1.7l-.25 5h-1.2zM5 7.1a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1z" />
                        <Path Classes="statusMark" Fill="{Binding StatusGlyphBrush}"
                              IsVisible="{Binding StatusIsError}"
                              Data="M2.1 1 5 3.9 7.9 1 9 2.1 6.1 5 9 7.9 7.9 9 5 6.1 2.1 9 1 7.9 3.9 5 1 2.1z" />
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{Binding StatusTextBrush}" />
                </Grid>
                <TextBlock Text="{Binding UpdateMessage}" Foreground="{Binding UpdateBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding UpdateMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <!-- ============================================================ abas -->
        <Grid>
        <!-- ============================================================ keyboard list -->
        <Grid ColumnDefinitions="340,*" IsVisible="{Binding !IsConnected}">
            <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,18">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,10">
                        <TextBlock Classes="section" Text="{loc:T keyboards_header}" VerticalAlignment="Center" Margin="0" />
                        <Button Grid.Column="1" Classes="ghost" Content="{loc:T refresh}"
                                Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding !IsBusy}"
                                AutomationProperties.AcceleratorKey="F5"
                                ToolTip.Tip="{loc:T refresh_tip}" />
                    </Grid>
                    <Border Classes="note" DockPanel.Dock="Top" IsVisible="{Binding !Devices.Count}">
                        <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                                   Text="{loc:T no_keyboard_found}" />
                    </Border>
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="{loc:T keyboards_found}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:DeviceInfo">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="2,4">
                                    <Ellipse Grid.Row="0" Width="8" Height="8" Fill="{StaticResource Ok}"
                                             VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontSize="12"
                                               Text="{Binding Summary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="22" Margin="40,0">
                <svg:Svg Path="/Brand/keyboard-list.svg" Width="560" Stretch="Uniform"
                         IsHitTestVisible="False" />
                <StackPanel Spacing="22" HorizontalAlignment="Center"
                            IsVisible="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="28" RowSpacing="6" HorizontalAlignment="Center">
                        <TextBlock Grid.Row="0" Classes="muted" Text="{loc:T connection}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="dim" Text="{Binding SelectedDevice.ConnectionKind}" />
                        <TextBlock Grid.Row="1" Classes="muted" Text="{loc:T serial}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="dim" Text="{Binding SelectedDevice.SerialText}"
                                   FontFamily="Consolas,DejaVu Sans Mono,Menlo,monospace" />
                        <TextBlock Grid.Row="2" Classes="muted" Text="{loc:T family}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="dim" Text="{Binding SelectedDevice.FamilyName}" />
                    </Grid>
                    <Button Classes="primary" Content="{loc:T connect}" Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Center" Padding="28,11" FontSize="14" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TabControl Margin="10,0,10,10" SelectedIndex="{Binding SelectedTabIndex}" IsVisible="{Binding IsConnected}">

            <!-- ================================================== mapping -->
            <TabItem Header="{loc:T tab_mapping}" ToolTip.Tip="Alt+1" AutomationProperties.AcceleratorKey="Alt+1">
                <views:MappingTab x:Name="Mapping" />
            </TabItem>

            <!-- ================================================== macros -->
            <TabItem Header="{loc:T tab_macros}" ToolTip.Tip="Alt+2" AutomationProperties.AcceleratorKey="Alt+2">
                <views:MacrosTab />
            </TabItem>

            <!-- ================================================== settings -->
            <TabItem Header="{loc:T tab_config}" ToolTip.Tip="Alt+3" AutomationProperties.AcceleratorKey="Alt+3">
                <views:ConfigTab />
            </TabItem>

            <!-- ================================================== perfis -->
            <TabItem Header="{loc:T tab_profiles}" ToolTip.Tip="Alt+4" AutomationProperties.AcceleratorKey="Alt+4">
                <views:ProfilesTab />
            </TabItem>

            <!-- ================================================== about the keyboard -->
            <TabItem Header="{loc:T tab_about}" ToolTip.Tip="Alt+5" AutomationProperties.AcceleratorKey="Alt+5">
                <views:AboutTab />
            </TabItem>
        </TabControl>
        </Grid>
    </DockPanel>
    <!-- ================================================================ save to the keyboard -->
    <views:SaveDialog />
    <!-- ====== profile name: new, copy, rename, delete ====== -->
    <views:NameDialog />
    </Grid>
</Window>

